{
  "name": "lexorma",
  "private": true,
  "version": "1.0.0",
  "description": "Lexorma React(CSR) 화면 - 빌드 결과(dist)는 lexorma-app jar 의 static/ 에 포함된다",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "poc:erd": "vite --config vite.poc.config.ts",
    "poc:erd:build": "vite build --config vite.poc.config.ts",
    "poc:erd:preview": "vite preview --config vite.poc.config.ts"
  },
  "dependencies": {
    "@primer/octicons-react": "19.15.5",
    "@tanstack/react-query": "5.80.7",
    "@tanstack/react-table": "8.21.3",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "lucide-react": "0.515.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.6.2",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
