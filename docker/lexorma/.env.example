# Lexorma Docker Compose settings — copy this file to .env and edit it (.env is ignored by Git):
#   cp .env.example .env
#   docker compose -p lexorma up -d
# docker compose reads .env from this folder (or a file given with --env-file).

# ---------------------------------------------------------------- Database (PostgreSQL)
# For a new installation, change the password. The values below keep the database name,
# account and data directory used by earlier versions of this Compose file.
POSTGRES_DB=lexorma
POSTGRES_USER=lexorma
POSTGRES_PASSWORD=lexorma
# Port on the host for direct database access (inside Docker the application uses 5432)
POSTGRES_PORT=15439

# ---------------------------------------------------------------- Data directories (relative to this folder)
# PostgreSQL data — keep this directory to keep your data across upgrades
POSTGRES_DATA_DIR=../volume/lexorma
# Application data directory mounted at /data
LEXORMA_DATA_DIR=../volume/h2

# ---------------------------------------------------------------- Application
LEXORMA_IMAGE=lexorma/lexorma
LEXORMA_PORT=9940

# ---------------------------------------------------------------- Secret encryption key (optional)
# Needed only to store source database passwords. Leave both empty to run without a key.
# The key list is passed to the container as a Docker secret (not as an environment variable).
# After setting or changing the key, recreate the application container:
#   docker compose -p lexorma up -d --force-recreate lexorma-app
#   Create a key:  openssl rand -base64 32   → prefix it with a key id, e.g. prod:<generated value>
#   Rotation:      new key first, keep the old one while stored passwords still use it:
#                  LEXORMA_SECRET_KEYS=k2:<new key>,prod:<old key>  and  LEXORMA_SECRET_ACTIVE_KEY_ID=k2
#   A lost key cannot be recovered: passwords encrypted with it must be registered again.
#   Keep a copy of the key separate from database backups.
LEXORMA_SECRET_KEYS=
# Key used for new encryption (must be in the list). Empty = the first key in the list
LEXORMA_SECRET_ACTIVE_KEY_ID=
